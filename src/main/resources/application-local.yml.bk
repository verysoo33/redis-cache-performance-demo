
server:
  port:

management:
  endpoints:
    web:
      exposure:
        include: "*"

spring:
  output:
    ansi:
      enabled: always
  datasource:
    url:
    username:
    password:
  jpa:
    show-sql: false
    generate-ddl: false
    hibernate:
      ddl-auto: update
#      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.dolgo.v2.config.CustomDialectConfig
#        dialect: org.hibernate.dialect.H2Dialect
        use_sql_comments: true
        format_sql: true
#  h2:
#    console:
#      enabled: true
#      path: /h2-console
  flyway:
    baseline-on-migrate: true
    enabled: true
  config:
    activate:
      on-profile: local
  mail:
    host: smtp.gmail.com
    port: 587
    username: info@dolgo.org
    password: Ehfrhehsp1@
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB
  redis:
    host:
    port:
    database:
    password:

logging:
  level:
    org:
      hibernate:
        SQL: DEBUG
      springframework:
        web: DEBUG
        data: DEBUG
      boot:
        autoconfigure:
          data:
            rest: DEBUG
            jpa: DEBUG
            orm: DEBUG