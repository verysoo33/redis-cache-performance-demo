
server:
  port:

management:
  endpoints:
    web:
      exposure:
        include: "*"

spring:
  output:
    ansi:
      enabled: always
  datasource:
    url:
    username:
    password:
  jpa:
    show-sql: false
    generate-ddl: false
    hibernate:
      ddl-auto: update
#      ddl-auto: validate
    properties:
      hibernate:
        dialect: soo.demo.config.CustomDialectConfig
        use_sql_comments: true
        format_sql: true
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB
  redis:
    host:
    port:
    database:
    password:

logging:
  level:
    org:
      hibernate:
        SQL: DEBUG
      springframework:
        web: DEBUG
        data: DEBUG
      boot:
        autoconfigure:
          data:
            rest: DEBUG
            jpa: DEBUG
            orm: DEBUG